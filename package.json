{
  "name": "simde",
  "version": "2.5.0",
  "description": "Educational superscalar and VLIW simulator",
  "homepage": "https://github.com/SIMDE-ULL/SIMDE",
  "bugs": {
    "url": "https://github.com/SIMDE-ULL/SIMDE/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SIMDE-ULL/SIMDE.git"
  },
  "license": "GPL-3.0",
  "author": "The SIMDE authors",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "check": "biome check --apply ./src",
    "dev": "react-router dev",
    "docs": "typedoc src/root.tsx --excludePrivate --out build/docs",
    "fmt": "biome format --write ./src",
    "lint": "biome lint --apply ./src",
    "start": "npx serve build/client",
    "test": "vitest run --dir ./src",
    "test:coverage": "vitest run --coverage",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@react-router/node": "^7.13.1",
    "@reduxjs/toolkit": "^2.11.2",
    "bootstrap": "^5.1.3",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "i18next": "^23.0.0",
    "isbot": "^5",
    "normalize.css": "^8.0.1",
    "react": "^19.2.4",
    "react-bootstrap": "^2.4.0",
    "react-colorful": "^5.6.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.0.0",
    "react-redux": "^9.0.0",
    "react-router": "^7.13.1",
    "typescript-parsec": "^0.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.6.1",
    "@react-router/dev": "^7.13.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.0.0",
    "sass": "^1.98.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.0.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ],
    "patchedDependencies": {
      "@restart/ui@1.9.4": "patches/@restart__ui@1.9.4.patch"
    }
  }
}
